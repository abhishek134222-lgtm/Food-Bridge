# FoodBridge Environment Configuration Template
# Copy this file to .env for local development

# HTTP Server Port
PORT=8080

# Neon PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql://foodbridge_owner:sample_password@ep-example.us-east-2.aws.neon.tech/foodbridge?sslmode=require

# Allowed CORS Origins for Frontend API Requests (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://localhost:3000
